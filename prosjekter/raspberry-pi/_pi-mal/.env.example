# Eksempel – kopier til .env og fyll inn. .env sjekkes ALDRI inn i Git.
# (nytt-prosjekt.sh lager .env automatisk fra denne filen.)

# Enhetens navn og plassering: maker/<STED>/<ENHET>/<navn>
ENHET=pi-sentral
STED=verksted

# MQTT-broker. mqtt.local peker alltid til maskinen som kjører broker.
# Bruker og passord står i ~/maker/infrastruktur/.env (fylles inn av nytt-prosjekt.sh)
MQTT_VERT=mqtt.local
MQTT_PORT=1883
MQTT_BRUKER=maker
MQTT_PASSORD=

# Sekunder mellom målinger
MALEINTERVALL=10
