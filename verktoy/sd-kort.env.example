# Eksempel – kopier til sd-kort.env og fyll inn. sd-kort.env sjekkes ALDRI inn i Git.
# Brukes av verktoy/lag-sd-kort.sh. Tomme verdier blir spurt om når skriptet kjøres.

# Wi-Fi som Pi-ene skal koble til (samme nett som PC-en)
WIFI_SSID=
WIFI_PASSORD=
WIFI_LAND=NO

# Brukeren på Pi-en (samme som på PC-en, så holder det med «ssh pi-sentral»)
PI_BRUKER=odd_christian
