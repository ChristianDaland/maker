{
  "uid": "verksted",
  "title": "Verksted – oversikt",
  "tags": ["maker"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "enhet",
        "label": "Enhet",
        "type": "query",
        "datasource": { "type": "influxdb", "uid": "influxdb-maker" },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"maalinger\", tag: \"enhet\")",
        "definition": "schema.tagValues(enhet)",
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Målinger",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 12 },
      "datasource": { "type": "influxdb", "uid": "influxdb-maker" },
      "fieldConfig": {
        "defaults": { "displayName": "${__field.labels.enhet} – ${__field.labels.navn}" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-maker" },
          "query": "import \"types\"\nfrom(bucket: \"maalinger\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._field == \"verdi\" and r.enhet =~ /^${enhet:regex}$/)\n  |> filter(fn: (r) => types.isType(v: r._value, type: \"float\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with navn: r._measurement}))\n  |> keep(columns: [\"_time\", \"_value\", \"enhet\", \"navn\"])\n  |> group(columns: [\"enhet\", \"navn\"])"
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Status (siste melding per enhet)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "influxdb", "uid": "influxdb-maker" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influxdb-maker" },
          "query": "from(bucket: \"maalinger\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"status\" and r._field == \"verdi\")\n  |> last()\n  |> keep(columns: [\"_time\", \"sted\", \"enhet\", \"_value\"])\n  |> group()"
        }
      ]
    }
  ]
}
