# Kopier til .env og fyll inn – eller kjør ./lag-env.sh, som lager tilfeldige passord.
# .env sjekkes ALDRI inn i Git.

# MQTT (Mosquitto). Samme bruker brukes av ESP32-ene (secrets.h), Telegraf og Node-RED.
MQTT_BRUKER=maker
MQTT_PASSORD=

# InfluxDB
INFLUX_BRUKER=admin
INFLUX_PASSORD=
INFLUX_ORG=maker
INFLUX_BUCKET=maalinger
# Hvor lenge målinger lagres (f.eks. 365d, 0 = for alltid)
INFLUX_LAGRINGSTID=0
INFLUX_TOKEN=

# Node-RED
NODERED_BRUKER=admin
NODERED_PASSORD=
# Krypterer lagrede passord i Node-RED. Må ikke endres etterpå (da må passord i flyter legges inn på nytt).
NODERED_KRYPTERINGSNOKKEL=

# Grafana
GRAFANA_BRUKER=admin
GRAFANA_PASSORD=
